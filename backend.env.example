# Copy to backend/.env and set real values locally; NEVER commit .env
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/goyalnest?schema=public
# Generate securely; must have 32+ characters
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_EMAIL=admin@example.invalid
# Optional SMTP: blank disables delivery depending on configured outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
DEV_SHOW_OTP=false
# Configure any Razorpay/test gateway keys ONLY in local backend/.env
