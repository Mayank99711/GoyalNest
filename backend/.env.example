NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/goyalnest?schema=public"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32_CHARACTERS_MINIMUM
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@goyalnest.local
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
# SMTP is required for real tenant verification emails. Demo OTP is disabled by default.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only for local development. Never enable in production.
DEV_SHOW_OTP=false
